# Wzór pliku .env:  cp .env.example .env
# Wartości poniżej to PRZYKŁADOWE wartości developerskie, żeby projekt ruszył od razu po sklonowaniu.
# W każdym prawdziwym środowisku zmień hasła i JWT_SECRET. Plik .env jest w .gitignore.

# ---------- PostgreSQL (docker-compose.yml) ----------
DB_USER=room_booking
DB_PASSWORD=change-me-db-password
DB_NAME=room_booking
# Port bazy na hoście (dla uruchamiania API / testów bez Dockera)
DB_PORT=5435
# Port API na hoście
API_PORT=3000

# ---------- Aplikacja ----------
NODE_ENV=development
PORT=3000
# Używane przy uruchamianiu API bez Dockera (npm run dev). W kontenerze Compose nadpisuje host na "db".
DATABASE_URL=postgres://room_booking:change-me-db-password@localhost:5435/room_booking
# Osobna baza dla testów integracyjnych (nazwa MUSI kończyć się na _test; tworzona automatycznie przez testy)
TEST_DATABASE_URL=postgres://room_booking:change-me-db-password@localhost:5435/room_booking_test
# knex = PostgreSQL (domyślnie), memory = repositories in-memory
REPOSITORY=knex

# Minimum 32 znaki. Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
# Czas życia tokenu (format: 10s, 15m, 1h)
JWT_EXPIRES_IN=15m
# Cost factor bcrypt (10-15)
BCRYPT_COST=12

# ---------- Seed (npx knex seed:run) - konto ADMIN da się utworzyć tylko w ten sposób ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# Hasło kont USER z seeda (jan.kowalski@, anna.nowak@, piotr.wisniewski@, maria.zielinska@example.com)
SEED_USER_PASSWORD=change-me-user-password
