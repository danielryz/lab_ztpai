# Skopiuj do .env i uzupełnij. Wartości poniżej są przykładowe - NIE są prawdziwymi sekretami.
NODE_ENV=development
PORT=3000
# Hasło bazy dla docker-compose.yml (to samo wpisz w DATABASE_URL)
DB_PASSWORD=
DATABASE_URL=postgres://postgres:<DB_PASSWORD>@localhost:5434/room_booking
# knex = PostgreSQL (domyślnie), memory = repositories in-memory
REPOSITORY=knex

# Minimum 32 znaki. Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Czas życia tokenu (format: 10s, 15m, 1h). Domyślnie 15m.
JWT_EXPIRES_IN=15m
# Cost factor bcrypt (10-15). Domyślnie 12.
BCRYPT_COST=12

# Konta tworzone przez seed (npm run seed). ADMIN da się utworzyć tylko w ten sposób.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Hasło kont USER z seeda (jan.kowalski@, anna.nowak@, piotr.wisniewski@, maria.zielinska@example.com)
SEED_USER_PASSWORD=
