# Zadanie 04 - Room Booking API: authentication, authorization, konfiguracja
# Klient HTTP PhpStorm - wybierz środowisko "dev" (http-client.env.json + http-client.private.env.json).
# Przed przebiegiem: npm run seed. Wykonuj po kolei - tokeny zapisują się w client.global.

### ===== Zadanie 1 - Rejestracja =====

### 201 - email normalizowany do małych liter, rola USER, brak hasha
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "Jan.Nowy{{$random.integer(1000, 9999)}}@Example.com", "password": "bardzo-dlugie-haslo" }

### 400 - próba nadania roli ADMIN
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "hacker@example.com", "password": "bardzo-dlugie-haslo", "role": "ADMIN" }

### 400 - za krótkie hasło
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "krotkie@example.com", "password": "short" }

### 409 EMAIL_TAKEN - duplikat konta z seeda różniący się wielkością liter
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "JAN.KOWALSKI@EXAMPLE.COM", "password": "bardzo-dlugie-haslo" }

### ===== Zadanie 2 - Logowanie i JWT =====

### 200 - ADMIN
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

> {% client.global.set("adminToken", response.body.accessToken); %}

### 200 - jan.kowalski (USER, właściciel rezerwacji 1 i 4)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "jan.kowalski@example.com", "password": "{{userPassword}}" }

> {% client.global.set("janToken", response.body.accessToken); %}

### 200 - anna.nowak (USER, właścicielka rezerwacji 2)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "anna.nowak@example.com", "password": "{{userPassword}}" }

> {% client.global.set("annaToken", response.body.accessToken); %}

### 401 - zły email (porównaj z następnym: identyczny code i message)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "nie.istnieje@example.com", "password": "bardzo-dlugie-haslo" }

### 401 - złe hasło
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "jan.kowalski@example.com", "password": "zle-haslo-123" }

### 200 - /me
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{janToken}}

### ===== Zadanie 3 - authenticate: wszystkie przypadki 401 =====

### 401 UNAUTHORIZED - brak nagłówka
GET {{baseUrl}}/api/reservations

### 401 INVALID_AUTH_HEADER - Basic
GET {{baseUrl}}/api/reservations
Authorization: Basic YWRtaW46YWRtaW4=

### 401 INVALID_AUTH_HEADER - Bearer bez tokenu
GET {{baseUrl}}/api/reservations
Authorization: Bearer

### 401 INVALID_TOKEN - zły podpis (dopisany znak na końcu podpisu)
GET {{baseUrl}}/api/reservations
Authorization: Bearer {{janToken}}x

### 401 INVALID_TOKEN - zmieniony payload (role: ADMIN) z oryginalnym podpisem
< {%
  const [h, p, s] = client.global.get("janToken").split(".");
  const payload = JSON.parse(Window.atob(p.replace(/-/g, "+").replace(/_/g, "/")));
  payload.role = "ADMIN";
  const evil = Window.btoa(JSON.stringify(payload)).replace(/=+$/, "").replace(/\+/g, "-").replace(/\//g, "_");
  request.variables.set("tamperedToken", [h, evil, s].join("."));
%}
GET {{baseUrl}}/api/buildings
Authorization: Bearer {{tamperedToken}}

### 401 TOKEN_EXPIRED - uruchom server z JWT_EXPIRES_IN=10s, zaloguj się ponownie, odczekaj 10 s
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{janToken}}

### 400 - userId w body
POST {{baseUrl}}/api/reservations
Authorization: Bearer {{janToken}}
Content-Type: application/json

{ "roomId": 2, "userId": 3, "participants": 5, "startTime": "2026-12-15T10:00:00Z", "endTime": "2026-12-15T11:00:00Z" }

### 400 - reservedBy w body
POST {{baseUrl}}/api/reservations
Authorization: Bearer {{janToken}}
Content-Type: application/json

{ "roomId": 2, "reservedBy": "Anna Nowak", "participants": 5, "startTime": "2026-12-15T10:00:00Z", "endTime": "2026-12-15T11:00:00Z" }

### 201 - userId z tokenu, w odpowiedzi user: { id, email }
POST {{baseUrl}}/api/reservations
Authorization: Bearer {{janToken}}
Content-Type: application/json

{ "roomId": 2, "participants": 5, "startTime": "2026-12-16T10:00:00Z", "endTime": "2026-12-16T11:00:00Z" }

> {% client.global.set("janResId", response.body.id); %}

### ===== Zadanie 4 - role =====

### 200 - GET budynków: każdy zalogowany
GET {{baseUrl}}/api/buildings
Authorization: Bearer {{janToken}}

### 403 - USER nie tworzy budynku
POST {{baseUrl}}/api/buildings
Authorization: Bearer {{janToken}}
Content-Type: application/json

{ "name": "Budynek USER", "address": "ul. Zakazana 1" }

### 403 - USER nie zmienia sali
PATCH {{baseUrl}}/api/rooms/1
Authorization: Bearer {{janToken}}
Content-Type: application/json

{ "capacity": 500 }

### 403 - USER nie usuwa sali
DELETE {{baseUrl}}/api/rooms/1
Authorization: Bearer {{janToken}}

### 201 - ADMIN tworzy budynek
POST {{baseUrl}}/api/buildings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "Budynek D{{$random.integer(100, 999)}}", "address": "ul. Nowa 5, Kraków" }

> {% client.global.set("newBuildingId", response.body.id); %}

### 200 - ADMIN zmienia budynek
PATCH {{baseUrl}}/api/buildings/{{newBuildingId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "address": "ul. Zmieniona 2, Kraków" }

### 204 - ADMIN usuwa pusty budynek
DELETE {{baseUrl}}/api/buildings/{{newBuildingId}}
Authorization: Bearer {{adminToken}}

### 409 BUILDING_HAS_ROOMS
DELETE {{baseUrl}}/api/buildings/1
Authorization: Bearer {{adminToken}}

### ===== Zadanie 4 - ownership =====

### 200 - USER widzi tylko swoje rezerwacje (filtr dokłada backend)
GET {{baseUrl}}/api/reservations?status=CONFIRMED&sort=-startTime
Authorization: Bearer {{janToken}}

### 403 - filtr userId tylko dla ADMINa
GET {{baseUrl}}/api/reservations?userId=3
Authorization: Bearer {{janToken}}

### 200 - ADMIN widzi wszystkie
GET {{baseUrl}}/api/reservations
Authorization: Bearer {{adminToken}}

### 200 - ADMIN filtruje po userId
GET {{baseUrl}}/api/reservations?userId=3
Authorization: Bearer {{adminToken}}

### 200 - właściciel
GET {{baseUrl}}/api/reservations/1
Authorization: Bearer {{janToken}}

### 404 - obcy USER (nie zdradzamy, że rezerwacja istnieje)
GET {{baseUrl}}/api/reservations/1
Authorization: Bearer {{annaToken}}

### 200 - ADMIN
GET {{baseUrl}}/api/reservations/1
Authorization: Bearer {{adminToken}}

### 404 - obcy USER nie anuluje
PATCH {{baseUrl}}/api/reservations/{{janResId}}/cancel
Authorization: Bearer {{annaToken}}

### 200 - właściciel anuluje
PATCH {{baseUrl}}/api/reservations/{{janResId}}/cancel
Authorization: Bearer {{janToken}}

### 200 - ADMIN anuluje cudzą
PATCH {{baseUrl}}/api/reservations/2/cancel
Authorization: Bearer {{adminToken}}

### 409 RESERVATION_ALREADY_STARTED - reguła obowiązuje także ADMINa
PATCH {{baseUrl}}/api/reservations/4/cancel
Authorization: Bearer {{adminToken}}

### 409 ROOM_ALREADY_BOOKED - kolizja także dla ADMINa
POST {{baseUrl}}/api/reservations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "roomId": 3, "participants": 5, "startTime": "2026-11-10T10:30:00Z", "endTime": "2026-11-10T11:30:00Z" }

### 409 ROOM_CAPACITY_EXCEEDED - pojemność także dla ADMINa
POST {{baseUrl}}/api/reservations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "roomId": 1, "participants": 11, "startTime": "2026-12-20T10:00:00Z", "endTime": "2026-12-20T11:00:00Z" }

