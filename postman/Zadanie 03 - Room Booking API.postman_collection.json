{
  "info": {
    "name": "Zadanie 03 - Room Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Room Booking API - PostgreSQL (Docker), Knex, migracje, relacje, pagination, ochrona przed double booking.\n\nPrzed przebiegiem: `npm run db:up`, `npm run migrate`, `npm run seed`, `npm start` (katalog zad_3). Wykonuj requesty po kolei (R01 -> R35) albo cały Collection Runner. Dane są w bazie - przed ponownym przebiegiem uruchom `npm run seed`."
  },
  "item": [
    {
      "name": "Zadanie 1 - Constraints w bazie widziane przez API",
      "item": [
        {
          "name": "R01 POST budynek z istniejącą nazwą - UNIQUE (409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/buildings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budynek A\",\n  \"address\": \"ul. Duplikat 1, Kraków\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error.code = UNIQUE_VIOLATION\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNIQUE_VIOLATION\"));",
                  "pm.test(\"Brak szczegółów bazy w odpowiedzi\", () => pm.expect(pm.response.text()).to.not.include(\"buildings_name_unique\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "R02 POST sala w tym samym budynku z tą samą nazwą - UNIQUE (building_id, name) (409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/rooms",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buildingId\": 1,\n  \"name\": \"101\",\n  \"capacity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error.code = UNIQUE_VIOLATION\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNIQUE_VIOLATION\"));",
                  "pm.test(\"Brak szczegółów bazy w odpowiedzi\", () => pm.expect(pm.response.text()).to.not.match(/rooms_|duplicate key|detail/i));"
                ]
              }
            }
          ]
        }
      ]
    },
