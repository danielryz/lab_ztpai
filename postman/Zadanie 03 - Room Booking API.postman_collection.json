    {
      "name": "Zadanie 4 - Pagination, filtrowanie, sortowanie",
      "item": [
        {
          "name": "R20 GET domyślnie: page 1, limit 20, sort startTime (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/reservations",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"data + meta\", () => { pm.expect(b.data).to.be.an(\"array\"); pm.expect(b.meta).to.include({ page: 1, limit: 20 }); });",
                  "pm.test(\"Rosnąco po startTime\", () => { const t = b.data.map(r => Date.parse(r.startTime)); pm.expect(t).to.eql([...t].sort((a, c) => a - c)); });",
                  "pm.test(\"Każda rezerwacja ma salę z budynkiem\", () => b.data.forEach(r => pm.expect(r.room.building).to.have.keys(\"id\", \"name\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "R21 roomId=3 & status=CONFIRMED & sort=-startTime (200)",
          "request": {
            "method": "GET",
