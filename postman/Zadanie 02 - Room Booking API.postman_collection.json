    {
      "name": "Zadanie 5 - Anulowanie (state machine) + DTO",
      "item": [
        {
          "name": "R32 POST przyszła rezerwacja - 201 + Location (201)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/reservations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 2,\n  \"reservedBy\": \"Jan Kowalski\",\n  \"participants\": 5,\n  \"startTime\": \"2026-12-15T14:00:00.000Z\",\n  \"endTime\": \"2026-12-15T15:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"futureId\", pm.response.json().id);",
                  "pm.test(\"Nagłówek Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/reservations/\" + pm.response.json().id));",
                  "pm.test(\"Brak internalNote w odpowiedzi\", () => pm.expect(pm.response.json()).to.not.have.property(\"internalNote\"));",
                  "pm.test(\"cancelledAt = null\", () => pm.expect(pm.response.json().cancelledAt).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "R33 PATCH anulowanie przyszłej rezerwacji (200)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/reservations/{{futureId}}/cancel",
            "header": []
          },
          "event": [
