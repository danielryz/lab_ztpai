    {
      "name": "Zadanie 2 - Walidacja Zod",
      "item": [
        {
          "name": "R08 POST wiele błędów naraz + nieznane pola (400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/reservations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 1,\n  \"reservedBy\": \"Jo\",\n  \"participants\": 0,\n  \"startTime\": \"2026-12-10T10:00:00Z\",\n  \"endTime\": \"jutro\",\n  \"status\": \"CONFIRMED\",\n  \"id\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error.code = VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"Co najmniej 3 błędy\", () => pm.expect(pm.response.json().error.details.length).to.be.at.least(3));"
                ]
              }
            }
          ]
        },
