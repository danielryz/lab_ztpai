                ]
              }
            }
          ]
        },
        {
          "name": "R04 POST poprawna rezerwacja, strefa +01:00 (201)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/reservations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 2,\n  \"reservedBy\": \"  Anna Nowak  \",\n  \"participants\": 12,\n  \"startTime\": \"2026-12-01T10:00:00+01:00\",\n  \"endTime\": \"2026-12-01T11:30:00+01:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"createdId\", pm.response.json().id);",
                  "pm.test(\"Data zwrócona w UTC (09:00Z)\", () => pm.expect(pm.response.json().startTime).to.eql(\"2026-12-01T09:00:00.000Z\"));",
                  "pm.test(\"reservedBy po trim()\", () => pm.expect(pm.response.json().reservedBy).to.eql(\"Anna Nowak\"));",
                  "pm.test(\"Brak internalNote w odpowiedzi\", () => pm.expect(pm.response.json()).to.not.have.property(\"internalNote\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "R05 GET wszystkie rezerwacje (200)",
