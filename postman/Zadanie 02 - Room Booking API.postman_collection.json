{
  "info": {
    "name": "Zadanie 02 - Room Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Room Booking API - architektura warstwowa, Zod, error handling, reguły biznesowe.\n\nUruchom server (`npm start` w katalogu zad_2) i wykonuj requesty po kolei (R01 -> R37) albo cały Collection Runner. Dane są w pamięci - przed ponownym przebiegiem zrestartuj server."
  },
  "item": [
    {
      "name": "Zadanie 1 - Architektura (endpointy z zad. 01)",
      "item": [
        {
          "name": "R01 GET wszystkie sale (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/rooms",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "R02 GET sala 1 (200)",
