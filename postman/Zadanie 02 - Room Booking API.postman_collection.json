          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 500\", () => pm.response.to.have.status(500));",
                  "pm.test(\"error.code = INTERNAL_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"INTERNAL_ERROR\"));",
