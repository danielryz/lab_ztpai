{
  "name": "room-booking-api",
  "version": "5.0.0",
  "description": "Room Booking API - testy (Jest + Supertest), Docker Compose, eventy (audit log) i CI (GitHub Actions)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "knex migrate:latest",
    "migrate:status": "knex migrate:status",
    "rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
